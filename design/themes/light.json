{
  "$description": "Light theme. Every theme defines exactly the same set of tokens; the build fails if one is missing.",
  "$extensions": {
    "openarc": {
      "name": "light",
      "scheme": "light",
      "default": true
    }
  },
  "color": {
    "$type": "color",
    "canvas": {
      "bg": {
        "$value": "{palette.neutral.50}"
      },
      "dot": {
        "$value": "{palette.neutral.200}"
      }
    },
    "surface": {
      "panel": {
        "$value": "{palette.neutral.0}",
        "$description": "Sidebar, inspector, toolbars"
      },
      "card": {
        "$value": "{palette.neutral.0}"
      },
      "sunken": {
        "$value": "{palette.neutral.25}",
        "$description": "Context cards, code blocks"
      },
      "hover": {
        "$value": "{palette.neutral.50}"
      },
      "selected": {
        "$value": "{palette.indigo.50}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{palette.neutral.100}"
      },
      "default": {
        "$value": "{palette.neutral.150}"
      },
      "strong": {
        "$value": "{palette.neutral.200}"
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.neutral.900}"
      },
      "secondary": {
        "$value": "{palette.neutral.700}"
      },
      "tertiary": {
        "$value": "{palette.neutral.600}"
      },
      "quaternary": {
        "$value": "{palette.neutral.500}"
      },
      "on-accent": {
        "$value": "{palette.neutral.0}"
      }
    },
    "accent": {
      "solid": {
        "$value": "{palette.indigo.600}"
      },
      "text": {
        "$value": "{palette.indigo.600}"
      },
      "subtle": {
        "$value": "{palette.indigo.50}"
      },
      "rail": {
        "$value": "{palette.indigo.100}"
      }
    },
    "status": {
      "added": {
        "solid": {
          "$value": "{palette.jade.600}"
        },
        "text": {
          "$value": "{palette.jade.700}"
        },
        "subtle": {
          "$value": "{palette.jade.50}"
        }
      },
      "changed": {
        "solid": {
          "$value": "{palette.saffron.600}"
        },
        "text": {
          "$value": "{palette.saffron.700}"
        },
        "subtle": {
          "$value": "{palette.saffron.50}"
        }
      },
      "removed": {
        "solid": {
          "$value": "{palette.vermilion.600}"
        },
        "text": {
          "$value": "{palette.vermilion.700}"
        },
        "subtle": {
          "$value": "{palette.vermilion.50}"
        }
      },
      "context": {
        "solid": {
          "$value": "{palette.neutral.500}"
        },
        "text": {
          "$value": "{palette.neutral.600}"
        },
        "subtle": {
          "$value": "{palette.neutral.100}"
        }
      }
    },
    "syntax": {
      "control": {
        "$value": "{palette.indigo.600}"
      },
      "declaration": {
        "$value": "{palette.indigo.600}"
      },
      "name": {
        "$value": "{palette.azure.600}"
      },
      "value": {
        "$value": "{palette.magenta.600}"
      },
      "verb": {
        "$value": "{palette.neutral.900}"
      },
      "operator": {
        "$value": "{palette.neutral.500}"
      },
      "effect": {
        "$value": "{palette.neutral.600}"
      },
      "comment": {
        "$value": "{palette.neutral.500}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": "0 1px 2px oklch(0.2 0.02 275 / 0.06), 0 8px 24px -8px oklch(0.2 0.02 275 / 0.14)"
    },
    "overlay": {
      "$value": "-16px 0 40px -8px oklch(0.2 0.02 275 / 0.14)"
    }
  }
}
