  "flows": [
    {
      "id": "request",
      "name": "A request passes through the limiter",
      "description": "Every authenticated request now spends one token before it reaches its route. An empty bucket ends the request with 429 and a retry-after header.",
      "steps": ["Router.handle", "auth.requireAuth", "limits.rateLimit", "RateLimiter.check", "RateLimiter.bucketFor", "TokenBucket.refill", "TokenBucket.tryTake", "orders.createOrder"]
    },
    {
      "id": "startup",
      "name": "Server start-up wiring",
      "description": "buildServer creates one RateLimiter for the process and installs its middleware directly after authentication.",
      "steps": ["server.buildServer", "Clock.systemClock", "RateLimiter", "limits.rateLimit", "Router.use"]
    }
  ],
  "notes": [
    { "kind": "risk", "refs": ["RateLimiter.buckets"],
      "text": "Buckets are never evicted. Memory grows with every distinct client the process has ever seen." },
    { "kind": "behaviour", "refs": ["orders.createOrder", "config.MAX_ORDERS_PER_MINUTE", "config.LIMITS"],
      "text": "Order creation is no longer capped at 5 per minute. It now shares the general allowance, so a free user can place 20 orders at once and then about 60 a minute." },
    { "kind": "behaviour", "refs": ["server.buildServer", "limits.rateLimit"],
      "text": "The limiter runs after requireAuth, so unauthenticated requests are not limited at all." },
    { "kind": "note", "refs": ["RateLimiter"],
      "text": "Limits are held in process memory, so each server instance counts separately." }
