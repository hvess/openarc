{
  "name": "openarc",
  "version": "0.1.0",
  "private": true,
  "description": "Turns a code change into an interactive architecture diagram.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "openarc": "bin/openarc.mjs"
  },
  "scripts": {
    "build": "node tools/build.mjs examples/rate-limit",
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench": "node bench/generate.mjs 25 50 100 200",
    "serve": "python3 -m http.server 4719"
  }
}
