{
  "name": "openarc",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Turns a code change into an interactive architecture diagram.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "openarc": "bin/openarc.ts"
  },
  "scripts": {
    "build": "node tools/build.ts examples/rate-limit",
    "check": "node tools/check.ts",
    "typecheck": "tsc -p . && tsc -p viewer",
    "test": "node --test tests/*.test.ts",
    "bench": "node bench/generate.ts 25 50 100 200",
    "serve": "node tools/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
